# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Optional client-side fallback for Vercel/Static hosting.
# When set in Vercel Project Settings > Environment Variables, all devices (mobile, PC)
# accessing the site will automatically have Gemini API Key pre-configured permanently!
VITE_GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
